{
  "manifest_version": 3,
  "name": "Lume — leitor de curso",
  "description": "Importe a grade e acompanhe a reprodução das aulas dos seus cursos nas plataformas que você autorizar.",
  "version": "0.3.0",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Enviar este curso ao Lume",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://lumeacademy.site/*",
    "http://localhost:4173/*",
    "http://127.0.0.1:4173/*",
    "http://localhost:4321/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lumeacademy.site/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4321/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "optional_host_permissions": [
    "https://*.grancursosonline.com.br/*",
    "https://*.estrategiaconcursos.com.br/*",
    "https://*.alura.com.br/*",
    "https://*.rocketseat.com.br/*",
    "https://*.udemy.com/*",
    "https://*.coursera.org/*",
    "https://*.dio.me/*",
    "https://*.hotmart.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*.grancursosonline.com.br/*",
        "https://*.estrategiaconcursos.com.br/*",
        "https://*.alura.com.br/*",
        "https://*.rocketseat.com.br/*",
        "https://*.udemy.com/*",
        "https://*.coursera.org/*",
        "https://*.dio.me/*",
        "https://*.hotmart.com/*"
      ]
    }
  ]
}
